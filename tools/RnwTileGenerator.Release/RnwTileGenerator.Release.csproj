<Project Sdk="Microsoft.NET.Sdk">

  <!-- Release tool window (code-only WPF, ported from PMT). Published by build-release-tool.bat to
       release-tool\RNW-Release.exe; it must not run from its own bin folder (a release deletes bin/obj). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RnwTileGenerator.Release</RootNamespace>
    <AssemblyName>RNW-Release</AssemblyName>
    <StartupObject>RnwTileGenerator.Release.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RnwTileGenerator.Release.Core\RnwTileGenerator.Release.Core.csproj" />
  </ItemGroup>

</Project>